{
  "name": "@alabuga/uikit",
  "version": "17.3.1",
  "type": "module",
  "description": "UIKIT компонентная библиотека",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://nexus.lkds.alabuga.ru/repository/npm-hosted/"
  },
  "scripts": {
    "tokens:build": "style-dictionary build --config tokens/style-dictionary.config.mjs",
    "tokens:watch": "chokidar 'tokens/figma-tokens.json' -c 'npm run tokens:build'",
    "prebuild": "npm run tokens:build",
    "build": "tsup src/index.ts --dts --format esm,cjs --out-dir dist",
    "dev": "tsup src/index.ts --watch --dts --format esm,cjs --out-dir dist",
    "pack:test": "npm run build && npm pack",
    "pack:prod": "npm run build && npm pack --dry-run",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "publish:local": "npm publish --registry http://localhost:4873",
    "publish:prod": "npm run build && npm publish",
    "release:patch": "node scripts/publish.js patch",
    "release:minor": "node scripts/publish.js minor",
    "release:major": "node scripts/publish.js major",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test:ui": "playwright test --config=./tests/playwright.config.ts",
    "test:ui:update": "playwright test --config=./tests/playwright.config.ts --update-snapshots",
    "test:ui-headed": "playwright test --config=./tests/playwright.config.ts --headed"
  },
  "peerDependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11",
    "@mui/icons-material": "^6",
    "@mui/material": "^6",
    "@mui/x-data-grid": "^7",
    "@mui/x-date-pickers": "^7",
    "classnames": "^2",
    "date-fns": "^2",
    "i18next": "^23",
    "mobx": "^6.12.3",
    "mobx-react": "^9.1.1",
    "react": "^18.2.0",
    "react-dom": ">=18",
    "react-i18next": "^14",
    "react-router-dom": "^6.23.1"
  },
  "overrides": {
    "glob": "13.0.6",
    "react-is": "18.3.1"
  },
  "devDependencies": {
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "6.5.0",
    "@mui/material": "6.5.0",
    "@mui/x-data-grid": "7.29.12",
    "@mui/x-date-pickers": "7.29.4",
    "@playwright/test": "1.47.2",
    "@storybook/addon-docs": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@types/node": "22.19.15",
    "@types/react": "18.3.28",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "chokidar-cli": "3.0.0",
    "classnames": "2.5.1",
    "date-fns": "2.30.0",
    "http-server": "^14.1.1",
    "i18next": "23.16.8",
    "mobx": "^6.12.3",
    "mobx-react": "^9.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "14.1.3",
    "react-router-dom": "^6.23.1",
    "storybook": "8.6.18",
    "style-dictionary": "5.3.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
